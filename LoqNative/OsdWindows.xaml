<Window x:Class="LoqNative.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsdWindow" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="#B2000000"
        Topmost="True" ShowInTaskbar="False" IsHitTestVisible="False">
    <Border CornerRadius="6" Padding="12,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- DirectX ETW Frame Data (Stacked) -->
        <StackPanel Margin="0,0,15,0" VerticalAlignment="Center">
            <TextBlock x:Name="TxtFps" Foreground="#00FF50" FontWeight="Bold" FontSize="16" Text="-- FPS" />
            <TextBlock x:Name="TxtFpsLow" Foreground="#00CC40" FontWeight="SemiBold" FontSize="11" Text="-- 1% Low" Margin="0,2,0,0" />
        </StackPanel>
            <!-- GPU Telemetry -->
            <TextBlock x:Name="TxtGpu" Foreground="#32D74B" FontSize="14" Margin="0,0,15,0" Text="GPU: --°C | --W" />
            <!-- CPU Telemetry -->
            <TextBlock x:Name="TxtCpu" Foreground="#0A84FF" FontSize="14" Text="CPU: --°C | --W" />
        </StackPanel>
    </Border>
</Window>