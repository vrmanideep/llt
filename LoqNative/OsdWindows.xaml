<Window x:Class="LoqNative.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoqOSD" Height="50" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="#D8000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Left="20" Top="20" Foreground="White" FontFamily="Consolas">
    
    <Grid Margin="15,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtBig" Text="--" FontSize="28" FontWeight="Bold" Foreground="#00FF00" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtLow" Text="-- (1%)" FontSize="10" FontWeight="Bold" Foreground="#00AA00" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
        </StackPanel>
        
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
            <TextBlock x:Name="TxtGpu" Text="GPU: --°  -- RPM  --%  -- W" Foreground="#00FF00" FontSize="13" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtCpu" Text="CPU: --°  -- RPM  --%  -- W" Foreground="#00FFFF" FontSize="13" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>