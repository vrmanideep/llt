<Window x:Class="LoqNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOQ Native Tuning" Height="450" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" 
        Topmost="True" ShowInTaskbar="False">
    
    <Window.Resources>
        <Style x:Key="SegmentedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#323236"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" Background="#323236" CornerRadius="2" VerticalAlignment="Center" Margin="5,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#007AFF" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White" Cursor="Hand">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Direction="270"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#121214" CornerRadius="10" BorderBrush="#2C2C2E" BorderThickness="1.2">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="2,0,2,14">
                <TextBlock Text="LOQ CONTROL" Foreground="#EEEEEE" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Content="✕" Background="Transparent" Foreground="#666666" BorderThickness="0" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#1C1C1E" CornerRadius="8" BorderBrush="#262628" BorderThickness="1" Padding="8,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1" /> 
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1" /> 
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="CPU" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CpuData1" Text="--°C" Foreground="#E5E5EA" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CpuData2" Text="-- RPM" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock x:Name="CpuData3" Text="--% | -- GHz" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Border Grid.Column="1" Background="#2C2C2E" VerticalAlignment="Stretch" Margin="0,2"/>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="RAM" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RamData1" Text="-- / --" Foreground="#E5E5EA" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RamData2" Text="GB" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="3" Background="#2C2C2E" VerticalAlignment="Stretch" Margin="0,2"/>

                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="GPU" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="GpuData1" Text="--°C" Foreground="#E5E5EA" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="GpuData2" Text="-- RPM" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock x:Name="GpuData3" Text="--%" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Performance Mode" Foreground="#8E8E93" FontSize="11" FontWeight="Medium" Margin="2,0,0,6"/>
                <Border Background="#1C1C1E" CornerRadius="7" Padding="3" BorderBrush="#262628" BorderThickness="1">
                    <UniformGrid Columns="4">
                        <Button x:Name="BtnQuiet" Content="Quiet" Style="{StaticResource SegmentedButton}" Click="BtnThermalMode_Click"/>
                        <Button x:Name="BtnBalanced" Content="Auto" Style="{StaticResource SegmentedButton}" Click="BtnThermalMode_Click"/>
                        <Button x:Name="BtnPerformance" Content="Turbo" Style="{StaticResource SegmentedButton}" Click="BtnThermalMode_Click"/>
                        <Button x:Name="BtnCustom" Content="Custom" Style="{StaticResource SegmentedButton}" Click="BtnThermalMode_Click"/>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="GPU Mode" Foreground="#8E8E93" FontSize="11" FontWeight="Medium" Margin="2,0,0,6"/>
                <Border Background="#1C1C1E" CornerRadius="7" Padding="3" BorderBrush="#262628" BorderThickness="1">
                    <UniformGrid Columns="4">
                        <Button x:Name="BtnHybrid" Content="Hybrid" Style="{StaticResource SegmentedButton}" Click="BtnGpuMode_Click"/>
                        <Button x:Name="BtnIgpu" Content="iGPU" Style="{StaticResource SegmentedButton}" Click="BtnGpuMode_Click"/>
                        <Button x:Name="BtnAutoGpu" Content="Auto" Style="{StaticResource SegmentedButton}" Click="BtnGpuMode_Click"/>
                        <Button x:Name="BtnDgpu" Content="dGPU" Style="{StaticResource SegmentedButton}" Click="BtnGpuMode_Click"/>
                    </UniformGrid>
                </Border>
                
                <Button x:Name="BtnForceSleep" Content="⚡ Kill Rogue GPU Apps (Force Deep Sleep)" 
                        Margin="0,8,0,0" Padding="0,6" Background="#2C2C2E" Foreground="#34C759" 
                        FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" 
                        Click="BtnForceSleep_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="2,0,2,0">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="BatteryLimitText" Text="Battery Charge Limit: 80%" Foreground="#E5E5EA" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="BatteryWattage" Text="Charging: -- W" Foreground="#E5E5EA" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Slider x:Name="BatterySlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,0,0,12" ValueChanged="BatterySlider_ValueChanged"/>
                <Grid>
                    <CheckBox x:Name="CbStartup" Content="Run on Startup" Foreground="#E5E5EA" FontSize="12" VerticalAlignment="Center" Click="CbStartup_Click"/>
                    <TextBlock x:Name="BatteryPercent" Text="Charge: --%" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            
        </Grid>
    </Border>
</Window>